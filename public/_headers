# Cloudflare Pages response headers (phase 08). See docs/deploy.md.
# The service worker, the page shell and the manifest must always be revalidated, so a deploy
# reaches readers promptly; hashed build assets never change, so they can be cached for a year.

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
